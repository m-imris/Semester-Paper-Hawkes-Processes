
nll_ = lambda params: SEPOT_model.nll_LSE(params=params)

bounds = get_bounds(SE_fun=SE_fun,
                    impact_fun=impact_fun,
                    mark_dist=mark_dist,
                    ub=1e01,
                    ub_power=1e01)

x0 = differential_evolution(func=nll_,
                            bounds=bounds)

print(f"x0 = {x0.x}\n")

res = SEPOT_model.fit(method="L-BFGS-B",
                      x0=x0.x,
                      reparam=True,
                      LSE=False)

print(f"Estimates parameters:\n{res.x}\n")
print(f"Log likelihood evaluated at the estimated parameters:\n{-res.fun}\n")
if SE_fun == "Exp":
    print(f"Branching ratio: {res.x[1]/res.x[2]}\n")
else:
    print(f"Branching ratio: {res.x[1]/(res.x[2] * res.x[3])}\n")